# ---- Gemini (SOLO servidor — nunca NEXT_PUBLIC_) ----
GEMINI_API_KEY=AIza...
# Opcional. Por defecto gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# ---- Supabase ----
# La URL del proyecto sí puede ser pública.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# La anon key es pública por diseño (RLS la limita). La usa el browser para el
# flujo de auth (magic link). Dashboard → Settings → API → "anon" "public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# La service role key NUNCA se expone al cliente. Solo se usa en API routes / server.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Acceso a la app (Supabase Auth · magic link) ----
# Emails autorizados a entrar, separados por coma. Vacío = nadie entra.
ALLOWED_EMAILS=abogada@estudio.cl, socio@estudio.cl
