# ---- Gemini (SOLO servidor — nunca NEXT_PUBLIC_) ----
GEMINI_API_KEY=AIza...
# Opcional. Por defecto gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# ---- Supabase ----
# La URL del proyecto sí puede ser pública.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# La service role key NUNCA se expone al cliente. Solo se usa en API routes / server.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Acceso a la app (contraseña compartida) ----
# La contraseña que el usuario escribe en la pantalla de login.
APP_PASSWORD=cambia-esto
# Secreto largo y aleatorio. Es el valor que se guarda en la cookie de sesión.
# Generar con: openssl rand -hex 32
SESSION_SECRET=pon-aqui-un-valor-aleatorio-largo
